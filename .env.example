# Example environment variables for Cerabrasileira

# Frontend (Next.js storefront)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_example
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_KEY=pk_test_example

# Backend (Medusa)
DATABASE_URL=postgres://localhost/cerabrasileira
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000
AUTH_CORS=http://localhost:7000
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
